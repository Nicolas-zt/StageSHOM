nom_script=${0##*/}

# ********************************************************************
# fonction i_want_random : $RANDOM est pas posix alors on utilise shuf
# ********************************************************************
i_want_random() { 
	# genere 1 aleatoire de 6 chiffres
	shuf -n 1 -i 0-999999 |awk '{printf("%6.6d",$1)}'
}
#*******************************************************************************
# Fonction : affiche l'usage
#*******************************************************************************
print_usage() {
    echo "  * Usage : ${nom_script} [ options ] fich1 fich2 fich3  ...      ( version courante : $VERSION )"
	echo "   fich1 fich2 ...        : fichiers RNX2 ou RNX3, une ou plusieurs stations ( d.Z .o .rnx .crx.gz ) chemin relatif ou absolu"
    echo "                            pour infos sur formats et noms, cf. ${GS_DATABASE}/prairie/RINEX_303.pdf" 
    echo "   [ -force_unique ]      : ne traite que la premiere station detectee (cas des melanges rnx2/rnx3, e.g. usn9 et USN9"
	echo "   [ -aide ]              : affiche aide detaillee"
	echo "   [ -aide_options ]      : affiche ensemble des options du fichier option "
	echo "   [ -pas pas ]           : en secondes (e.g 0.1 / 30.): specifie le pas des donnees en sortie (0=toutes)"
	echo "   [ -ignore GREC ]       : codes (rinex) permettant de specifier les obs. ignorees a la lecture"
	echo "                             E=GALILEO G=GPS R=GLONASS C=COMPASS exemple : -ignore RG (ou GR) = garde uniquement GALILEO "
	echo "   [ -options ficopt ]    : avec chemin complet si specifie cf. option [-aide_options]"
	echo "                            Si non specifie depend du nom des fichiers rinex traites"
	echo "   [ -historik HISTORIK ] : avec chemin complet  : nom du fichier historik glonass (defaut) " 
 	echo "                            e.g. ${GS_DATABASE}/constell/historik_glonass (defaut)"
 	echo "  * ENTREES DES BIAIS     "
	echo "   [ -cc2noncc fichp1p2 ] : passe la correction cc2noncc avec fichier fichp1p2 (defaut = non)"
 	echo "                            note: a partir de v40 cette correction est faite dans prairie "
	echo "   [ -wsb FICHIERMUSAT ]  : avec chemin complet  : nom du fichier WSB "
 	echo "   [ -osb FICHIEROSB ]    : avec chemin complet : nom du fichier OSB (format SINEX BIAS)"
 	echo "                            -osb remplace -wsb (soit l'un soit les autres) "
	echo "   [ -optimal ]           : ajoute les options pour un traitement classique CC2NONCC + GPS (WL) + GLONASS "
	echo "   [ -no_historik ]       : supprime l'attache du fichier historik (pour associer [ -optimal -no_historik ] )"
 	echo "  * SORTIES PRINCIPALES:  "
	echo "   [ -path path ]         : repertoire de retour des pretraitements "  
	echo "   [ -f ]                 : force ecriture du fichier de sortie"
	echo "   [ -out ficout ]        : nom du fichier retour des donnees (dans path) " 
	echo "   [ -listing ficlis ]    : nom du fichier listing de prairie (dans path) " 
	echo "   [ -sort ]              : trie le fichier de mesures en sortie en fonction de la date (defaut = non)"
	echo "   [ -nopdgr ]            : supprime la sortie du fichier de mesures (cas des etudes WL pour eviter gros fichier)"
 	echo "  * SORTIES DIVERSES:     "
	echo "   [ -sor_wsb fic]        : nom eventuel du fichier de retour (dans path) du fichier SORTIE_MUSAT ( NONE => pas de retour)"
	echo "   [ -sor_p1c1 fic]       : nom eventuel du fichier de retour (dans path) du fichier BIAISMOYENS_WL_P1C1.dat ( NONE => pas de retour) "
	echo "   [ -sor_speciale fic]   : nom eventuel du fichier de retour (dans path) du fichier SPECIALE.dat  ( NONE => pas de retour) "
	echo "   [ -submit ]            : (specif. CNES) soumission linux3 avec attente de retour job (sinon interactif). "
	echo "                            si on ne veut pas attendre: lancer en batch" 
	echo "   [ -lT cputime ]        : (specif. CNES) temps reserve pour les jobs individuels soumis (sinon automatique) "
	echo "   [ -lM mem ]            : (specif. CNES) memoire reserve en megaoctets pour les jobs individuels soumis (defaut = $taille_mem) "
	echo ""
	echo "  * ENTREES ANNEXES"
	echo "   [ -v VERSION ]         : utilise la version specifiee (VERSION sous la forme \"vnn\" pour v34 et superieures) version defaut = $VERSION"
	echo "   [ -selection SELECTION ]: avec chemin complet : nom du fichier selection_obs a utiliser (sinon le defaut est utilise)" 
	echo "   [ -orb XXX ]: ajoute autom. les orbites parmis ${KNOWN_SP3_CODE} et calcule les elev/azim si les coord. stations dans l entete RNX "
	echo "                             si position entete inconnue, calcule la trajectoire et determine type mobile/statique. cf. aussi [-statique |-mobile]"
	echo "                             si option \"SCINTILLATION nn\" alors l'elev. nn sert de masque pour les scintillations"
	echo "   [ -orb XXX -repertoire_orb dir ] : recherche les orbites sp3 de la forme xxxwwwwd.sp3 ou xxxwwwwd.sp3.Z dans le repertoire dir (uniquement pour tests)"
	echo "   [ -orb nom_sp3_1 -orb nom_sp3_2 ... ] : prend les orbites fournies / incompatible avec ci dessus"
	echo "   [ -orbex orbex  ]       : fichier orbex pour calcul de l'attitude gzippe ou non  [ -orbex orbex.gz  ]  " 
	echo "   [ -meta(data) ficmeta ] : fichier metadata (defaut = $METADATA)" 
    echo "   [ -antex ficantex ]     : attache le fic. antex et applique les corrections PCO/PCV après la lecture (uniquement si -orb présent)" 
    echo "                                            si orbex absent  : calcul PCO radial uniquement"
    echo "                                            si orbex present : calcul PCO avec attitude + PCV" 
    echo "   [ -sinex sinex.snx ]    : fichier sinex comme source des coords station, antenne et rotation" 
 	echo "   [ -statique |-mobile ]  : si -orb present force le mode de calcul de la position/trajectoire (defaut = inconnu) " 
    echo "   [ -elevmin cutoff ]     : si -orb present supprime les données en dessous de cutoff (en degré) (v47)"
    echo "                             les données ou l'elev n'a pas pu etre calculee sont eliminees"
    echo "   [ -elevmin_keep_unkn cutoff ] : idem ci dessus mais les données ou l'elev n'a pas pu etre calculee sont gardées (v48)"
	echo "   [ -masque MASQUE ]      : si -orb present supprime les donnees hors du masque apres la lecture " 
    echo "                             notes : - les donnees sans info d elev/azim sont eliminees"
    echo "                                     - l'effet est cumule avec ELEVMIN"
	echo "                                     - si -orb est absent cette option (et ELEVMIN) sont ignorees."
	echo "                                     - exemple de fichier masque sous ${GS_DATABASE}/prairie/exemple_masque_5_10.txt"
	echo "   [ -eclipse sec ]        : suppression des données entre deb_ecl et fin_ecl + sec (sec > 0 ) "
	echo "                             ( ne fonctionne qu'avec [ -orb ] )" 
	echo "   [ -eclipse_bord sec ]   : idem -eclipse mais seules les donnees des eclipses à moins d'1H de 0H/24H sont supprimees"
    echo "   [ -freqs FF]            : selection les lignes concernant les freqs FF dans le fichier selection e.g -freqs 15 "
	echo "   [ -no_posit ]           : supprime le calcul de point meme si -orb (si on veut seulement [-eclipse], donc)"
    echo "   [ -acq_only ]           : stoppe prairie apres l'acquisition des donnees (affiche les statistiques) "
	echo "   [ -attitude ficatt ]    : attache le fichier d attitude ficatt"  
	echo "   [ -debug ]              : copie le repertoire de travail dans path/DEBUGPRAI"
	echo "   [ -raboule ]            : copie le  fichier selection type (defaut) sous le nom selection_observables.dat "
	echo ""
	echo "  * exemple1: ${nom_script}  -f  -options ${GS_DATABASE}/prairie/options_GPS.dat"
	echo "                         -cc2noncc ${GS_DATABASE}/prairie/p1c1bias.2000p "
	echo "                         -wsb ${GS_DATABASE}/prairie/WSBREF.res.dat "
	echo "                         -out SORTIE.ESS *d.Z"
	echo ""
	echo "  * exemple2: ${nom_script}  -f  *d.Z -orb GRG -options ${GS_DATABASE}/prairie/options_scintillation10.dat"
	echo ""
	return
}

print_options() {

cat  "${GS_DATABASE}/prairie/options.txt" 

return 
}
