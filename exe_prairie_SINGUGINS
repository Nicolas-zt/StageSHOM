	file_ext=\$1
	file_loc=\$2
	file_typ=\$3
	if [ -s \${file_ext} ] && [ -f \${file_ext} ] ; then 
	  # on accepte les fic zippés 
	  if gunzip -t \${file_ext} 2>/dev/null ; then
	    gunzip -c  \${file_ext} > \${file_loc}
	    echo "\$(ls -l \${file_loc})  ( \${file_ext} )" >> ${path}/${out}
	  else 
        ln -s \${file_ext} \${file_loc}  
        ls -l \${file_loc}  >> ${path}/${out}
      fi 
    else
      echo "ERR: file \${file_typ} \${file_ext} empty or not here"  
      exit 1    
    fi  
}
#  copie si fichier ok 
#  3 arguments :  nom_orig  nom_local nom_affichage    
verif_cp_file () {
	file_ext=\$1
	file_loc=\$2
	file_typ=\$3
	if [ -s \${file_ext} ] && [ -f \${file_ext} ] ; then 
      cp \${file_ext} \${file_loc}  
      chmod +w \${file_loc}
      echo "\$(ls -l \${file_loc})  ( \${file_ext} )" >> ${path}/${out} 
    else
      echo "ERR: file \${file_typ} \${file_ext} empty or not here"   
      exit 1    
    fi  
}


