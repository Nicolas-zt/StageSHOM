# fonction de test des fichiers et affichage erreur/plantage sinon
test_exit_file () {
	fic_exist="$1" 
	mess_err="$2" 
	if [ -s "${fic_exist}" ] && [ -f "${fic_exist}" ] ; then 
  	  return 0
  	else 
  	  echo "ERR: ${mess_err}"
  	  exit 1
    fi  
}

