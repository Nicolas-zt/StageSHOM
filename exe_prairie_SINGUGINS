    if [  -z "${out1}" ] ; then 
      out1=$(basename "$1")
    fi 
    out2=$(basename "$1")".out.prai"
  else 
    echo "fichier $1 absent ou option $1 inconnue "
  fi 
  shift
  ;; 
  esac
done 
